# Runtime
LAUNCHGUARD_ENV=development
LAUNCHGUARD_DB_PATH=data/launchguard.sqlite
LAUNCHGUARD_CHECKPOINT_PATH=data/checkpoints.sqlite
LAUNCHGUARD_POLICY_DIR=examples/policies
LAUNCHGUARD_FX_MODE=live

# Listing generation: deterministic is keyless and used in CI.
LAUNCHGUARD_GENERATOR=deterministic
# LAUNCHGUARD_LLM_BASE_URL=https://api.openai.com/v1
# LAUNCHGUARD_LLM_API_KEY=
# LAUNCHGUARD_LLM_MODEL=

# Shopify is always dry-run unless every live setting is present.
LAUNCHGUARD_SHOPIFY_MODE=dry-run
# LAUNCHGUARD_SHOPIFY_STORE=your-development-store.myshopify.com
# LAUNCHGUARD_SHOPIFY_TOKEN=
LAUNCHGUARD_SHOPIFY_API_VERSION=2026-10
